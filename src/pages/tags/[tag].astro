---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import Tokens from '../../components/Tokens.astro';
import { getPosts, TAGS } from '../../lib';

export function getStaticPaths() {
  return TAGS.map((tag) => ({ params: { tag } }));
}

const blurbs = {
  learnings: 'Lessons from work, written down so I keep them.',
  thoughts: 'Life, opinions, and things I am still figuring out.',
};

const { tag } = Astro.params as { tag: (typeof TAGS)[number] };
const posts = (await getPosts()).filter((p) => p.data.tags.includes(tag));
---
<Base title={tag}>
  <section class="hero">
    <h1>{tag[0].toUpperCase() + tag.slice(1)}</h1>
    <p class="intro">{blurbs[tag]}</p>
  </section>
  {posts.length ? <PostList posts={posts} /> : (
    <section class="empty">
      <Tokens text="This dimension of Deepak is still being built." />
      <p class="loss-nan">0 tokens trained · weights initialized · first checkpoint soon</p>
    </section>
  )}
</Base>
