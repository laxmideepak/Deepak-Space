---
import Base from '../layouts/Base.astro';
import Tokens from '../components/Tokens.astro';
import { TAGS } from '../lib';
---
<Base title="Not found">
  <section class="hero">
    <h1>404</h1>
    <Tokens text="This page isn’t in my vocabulary." lit />
    <p class="intro">Byte-level BPE never hits an unknown token. This URL did.</p>
  </section>
  <p class="pills">
    {TAGS.map((t) => <a href={`/tags/${t}`}>{t}</a>)}
    <a href="/">home</a>
  </p>
</Base>
