---
import Base from '../../layouts/Base.astro';
import { getPosts, fmt, tokenCount } from '../../lib';
import { render } from 'astro:content';

export async function getStaticPaths() {
  return (await getPosts()).map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, planted, tended, stage, tags } = post.data;
---
<Base title={title} description={description}>
  <article>
    <header class="post-header">
      <h1>{title}</h1>
      <dl class="post-facts">
        <div><dt>Stage</dt><dd>{stage}</dd></div>
        <div><dt>Planted</dt><dd>{fmt(planted)}</dd></div>
        {tended && <div><dt>Last tended</dt><dd>{fmt(tended)}</dd></div>}
        <div><dt>Length</dt><dd>{tokenCount(post.body)}</dd></div>
        <div><dt>Filed in</dt><dd>{tags.map((t) => <a href={`/tags/${t}`}>{t}</a>)}</dd></div>
      </dl>
    </header>
    <div class="prose post-body"><Content /></div>
  </article>
</Base>
