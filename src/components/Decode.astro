---
// Deepak's reply, "decoded" one token at a time. A small model was teacher-forced
// on this exact text offline (scripts/export_inference.py); where its greedy guess
// matched, the token just appears; where it missed, its guess shows struck through
// and Deepak's real token lands. Works fully without JS: the final text is in the HTML.
import inference from '../data/inference.json';

interface Props { lines: string[] }
const { lines } = Astro.props;

const text = lines.join('\n');
if (inference.lines.join('\n') !== text || inference.tokens.map((t) => t.text).join('') !== text) {
  throw new Error('Homepage reply changed since the last export. Run: python scripts/export_inference.py');
}

const { tokens, model, alpha } = inference;
const hits = tokens.filter((t) => t.hit).length;
const modelName = model.split('/').pop()!.replace(/-Instruct$/, '');
// Compact per-token data for the script: guess, hit, probability, bits, top-5.
const data = tokens.map((t) => ({ g: t.guess, h: t.hit, p: t.p, b: t.bits, k: t.top5 }));
---
<div class="decode" data-decode data-model={modelName}>
  <p class="reply" tabindex="0" aria-describedby="decode-legend">
    <span class="sr-only">{lines.join(' ')}</span>
    {tokens.map((t, i) => {
      // Tokens must sit flush: any whitespace between these spans would render as a space.
      // A newline inside a token becomes a <br> inside that same token's span.
      const parts = t.text.split('\n');
      return <span class:list={['dt', `t${i % 4}`, { miss: !t.hit }]} data-i={i} aria-hidden="true">{parts.map((part, j) => <>{j > 0 && <br />}{part}</>)}</span>;
    })}
  </p>
  <p class="chatml" aria-hidden="true">&lt;|im_end|&gt;</p>
  <p class="legend" id="decode-legend">faint = what a small model guessed I’d say · where it’s wrong, that’s me</p>
  <p class="statusbar">
    <span class="sr-only">A {modelName} model, reading my system prompt, predicted {hits} of these {tokens.length} tokens.</span>
    <span class="tagline" aria-hidden="true">deepak-24 · one token at a time</span>
    <span aria-hidden="true"><b data-state>DONE {tokens.length} tok</b></span>
    <span aria-hidden="true">α <b>{alpha.toFixed(2)}</b></span>
    <span aria-hidden="true">KV <b data-kv-cell>cold</b></span>
  </p>
  <div class="pop" hidden aria-hidden="true"></div>
  <script is:inline type="application/json" set:html={JSON.stringify(data).replace(/</g, '\\u003c')} />
  <script is:inline>
    (() => {
      const root = document.currentScript.closest('[data-decode]');
      const data = JSON.parse(root.querySelector('script[type="application/json"]').textContent);
      const reply = root.querySelector('.reply');
      const toks = [...root.querySelectorAll('.dt')];
      const state = root.querySelector('[data-state]');
      const pop = root.querySelector('.pop');
      const html = document.documentElement;
      const total = toks.length;
      const kv = html.dataset.kv === 'hit'; // set in <head> before the prompt paints
      let timer, i = 0, active = 0;
      root.querySelector('[data-kv-cell]').textContent = kv ? 'hit · prefill skipped' : 'cold';

      const skipEvents = ['keydown', 'pointerdown', 'wheel', 'touchstart'];
      const finish = () => {
        clearTimeout(timer);
        skipEvents.forEach((e) => removeEventListener(e, finish, true));
        root.querySelectorAll('.ghost').forEach((g) => g.remove());
        toks.forEach((t) => { t.classList.add('on'); t.classList.remove('contested'); });
        root.classList.remove('decoding');
        root.classList.add('done');
        state.textContent = `DONE ${total} tok`;
        try { sessionStorage.setItem('kv', '1'); } catch {}
      };

      // One token at a time: hits appear, misses show the model's guess first.
      const step = () => {
        if (i >= total) return finish();
        const t = toks[i], d = data[i];
        state.textContent = `DECODE ${i + 1}/${total}`;
        if (d.h) {
          t.classList.add('on');
          i++;
          timer = setTimeout(step, 30);
          return;
        }
        const ghost = document.createElement('span');
        ghost.className = 'ghost';
        ghost.setAttribute('aria-hidden', 'true');
        ghost.textContent = d.g.replace(/\n/g, ' ').trim() || '·';
        t.before(ghost);
        t.classList.add('contested');
        timer = setTimeout(() => {
          ghost.remove();
          t.classList.remove('contested');
          t.classList.add('on', 'landed');
          i++;
          timer = setTimeout(step, 50);
        }, 120);
      };

      const still = html.classList.contains('plain') || new URLSearchParams(location.search).has('still')
        || matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (still || kv) {
        finish();
      } else {
        root.classList.add('decoding');
        skipEvents.forEach((e) => addEventListener(e, finish, true));
        timer = setTimeout(step, 450);
      }

      // Popover: the model's top-5 for the token under the pointer or keyboard focus.
      const label = (s) => `“${s.replace(/\n/g, '↵')}”`;
      const pct = (p) => (p < 0.001 ? '<0.001' : p.toFixed(3));
      const show = (n) => {
        if (!root.classList.contains('done') || html.classList.contains('plain')) return;
        active = n;
        const d = data[n], t = toks[n];
        toks.forEach((x) => x.classList.toggle('active', x === t));
        pop.replaceChildren();
        const head = document.createElement('p');
        head.className = 'pop-head';
        head.textContent = `${label(t.textContent)}  p ${pct(d.p)} · ${d.b} bits · ${d.h ? 'predicted' : 'missed'}`;
        pop.append(head);
        for (const [s, p] of d.k) {
          const row = document.createElement('p');
          row.className = 'pop-row';
          const name = document.createElement('span');
          name.textContent = label(s);
          const bar = document.createElement('span');
          bar.className = 'pop-bar';
          bar.style.setProperty('--w', `${Math.max(p * 100, 1)}%`);
          const val = document.createElement('span');
          val.textContent = pct(p);
          row.append(name, bar, val);
          pop.append(row);
        }
        const foot = document.createElement('p');
        foot.className = 'pop-foot';
        foot.textContent = `teacher-forced · the text is mine, the probabilities are ${root.dataset.model}’s`;
        pop.append(foot);
        pop.hidden = false;
        const r = t.getBoundingClientRect(), box = root.getBoundingClientRect();
        pop.style.left = `${Math.max(0, Math.min(r.left - box.left, box.width - pop.offsetWidth))}px`;
        pop.style.top = `${r.bottom - box.top + 8}px`;
      };
      const hide = () => {
        pop.hidden = true;
        toks.forEach((x) => x.classList.remove('active'));
      };
      reply.addEventListener('mouseover', (e) => { const t = e.target.closest('.dt'); if (t) show(+t.dataset.i); });
      reply.addEventListener('click', (e) => { const t = e.target.closest('.dt'); if (t) show(+t.dataset.i); });
      reply.addEventListener('mouseleave', () => { if (document.activeElement !== reply) hide(); });
      reply.addEventListener('focus', () => show(active));
      reply.addEventListener('blur', hide);
      // Touch browsers may never focus the reply, so also dismiss on any tap elsewhere.
      addEventListener('pointerdown', (e) => { if (!pop.hidden && !reply.contains(e.target)) hide(); });
      reply.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
          e.preventDefault();
          show(Math.min(total - 1, Math.max(0, active + (e.key === 'ArrowRight' ? 1 : -1))));
        } else if (e.key === 'Escape') {
          reply.blur();
        }
      });
    })();
  </script>
</div>
