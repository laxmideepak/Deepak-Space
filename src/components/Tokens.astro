---
import { tokenize } from '../lib';

// A line of text shown as its tinted GPT-4o tokens, with the count.
interface Props { text: string }
const { text } = Astro.props;
const tokens = tokenize(text);
---
<p class="tokens">
  <span class="sr-only">{text}</span>
  {tokens.map((t, i) => <span class={`t${i % 4}`} aria-hidden="true">{t}</span>)}
  {' '}<span class="count" aria-hidden="true">{tokens.length} tokens</span>
</p>
