---
// The homepage as one ChatML turn, scored by a small model offline
// (scripts/export_inference.py -> src/data/inference.json):
// - the system prompt is "prefilled": every token is shaded by how surprised the model was;
// - the reply "decodes" one token at a time; where the model's greedy guess missed,
//   its guess stays above the word, struck through.
// The text is mine, the probabilities are the model's. Works fully without JS.
import inference from '../data/inference.json';

interface Props {
  system: [string, boolean][]; // [text, emphasized?] parts of the system prompt
  lines: string[];             // the reply, one string per line
}
const { system, lines } = Astro.props;

const systemText = system.map(([s]) => s).join('');
const replyText = lines.join('\n');
const rerun = 'Run: python scripts/export_inference.py';
if (inference.system !== systemText || inference.system_tokens.map((t) => t.text).join('') !== systemText) {
  throw new Error(`System prompt changed since the last export. ${rerun}`);
}
if (inference.lines.join('\n') !== replyText || inference.tokens.map((t) => t.text).join('') !== replyText) {
  throw new Error(`Homepage reply changed since the last export. ${rerun}`);
}

const { model, layers, alpha, system_alpha, tokens, system_tokens } = inference;
const modelName = model.split('/').pop()!.replace(/-Instruct$/, '');
const hits = tokens.filter((t) => t.hit).length;

// Which system tokens fall inside an emphasized part (any non-space character overlapping).
const emRanges: [number, number][] = [];
let offset = 0;
for (const [s, em] of system) {
  if (em) emRanges.push([offset, offset + s.length]);
  offset += s.length;
}
offset = 0;
const systemSpans = system_tokens.map((t) => {
  const start = offset + (t.text.length - t.text.trimStart().length);
  const end = offset + t.text.trimEnd().length;
  offset += t.text.length;
  return { ...t, em: emRanges.some(([a, b]) => start < b && end > a), heat: Math.min(t.bits / 20, 1).toFixed(2) };
});

const guessLabel = (s: string) => s.replace(/\n/g, '↵').trim() || '·';
// Compact per-token data for the script: guess, hit, probability, bits, top-5.
const pack = (ts: typeof tokens) => ts.map((t) => ({ g: t.guess, h: t.hit, p: t.p, b: t.bits, k: t.top5 }));
const data = { system: pack(system_tokens), reply: pack(tokens) };
---
<div class="chat" data-chat data-model={modelName} style={`--layers: ${layers}`}>
  <p class="chatml" aria-hidden="true">&lt;|im_start|&gt;system</p>
  <p class="chat-system scored" data-set="system" tabindex="0" aria-describedby="chat-legend">
    <span class="sr-only">{systemText}</span>
    {systemSpans.map((t, i) => <span class:list={['st', { em: t.em }]} data-i={i} style={`--heat: ${t.heat}`} aria-hidden="true">{t.text}</span>)}
  </p>
  <p class="chatml" aria-hidden="true"><span>&lt;|im_end|&gt;</span><span>updated Oct 2026 · prompt α {system_alpha.toFixed(2)}</span></p>
  <p class="chatml" aria-hidden="true">&lt;|im_start|&gt;assistant</p>
  <p class="reply scored" data-set="reply" tabindex="0" aria-describedby="chat-legend">
    <span class="sr-only">{lines.join(' ')}</span>
    {tokens.map((t, i) => {
      // Tokens must sit flush: any whitespace between these spans would render as a space.
      // A newline inside a token becomes a <br> inside that same token's span.
      const parts = t.text.split('\n');
      return <span class:list={['dt', `t${i % 4}`, { miss: !t.hit }]} data-i={i} data-guess={t.hit ? undefined : guessLabel(t.guess)} aria-hidden="true">{parts.map((part, j) => <>{j > 0 && <br />}{part}</>)}</span>;
    })}
  </p>
  <p class="chatml chat-end"><span aria-hidden="true">&lt;|im_end|&gt;</span><a class="chip argmax" href="/notes" data-argmax>notes ↩</a></p>
  <p class="legend" id="chat-legend">struck through = what a small model guessed I’d say · where it’s wrong, that’s me · hover any word for its odds · <a href="/try">try it on your own words</a></p>
  <p class="hallucination" data-hallucination aria-live="polite" hidden></p>
  <p class="statusbar">
    <span class="sr-only">A {modelName} model, reading my system prompt, predicted {hits} of these {tokens.length} tokens.</span>
    <span class="tagline" aria-hidden="true">deepak-24 · one token at a time</span>
    <span aria-hidden="true"><b data-state>DONE {tokens.length} tok</b></span>
    <span aria-hidden="true">α <b>{alpha.toFixed(2)}</b></span>
    <span aria-hidden="true">KV <b data-kv-cell>cold</b></span>
    <span aria-hidden="true">T <b data-temp>0.7</b></span>
    <button type="button" class="replay" data-replay hidden>↺ replay</button>
  </p>
  <div class="pop" hidden aria-hidden="true"></div>
  <script is:inline type="application/json" set:html={JSON.stringify(data).replace(/</g, '\\u003c')} />
  <script is:inline>
    (() => {
      const root = document.currentScript.closest('[data-chat]');
      const data = JSON.parse(root.querySelector('script[type="application/json"]').textContent);
      const html = document.documentElement;
      const reply = root.querySelector('.reply');
      const toks = [...reply.querySelectorAll('.dt')];
      const state = root.querySelector('[data-state]');
      const replay = root.querySelector('[data-replay]');
      const pop = root.querySelector('.pop');
      const total = toks.length;
      const kv = html.dataset.kv === 'hit'; // set in <head> before the prompt paints
      const still = () => html.classList.contains('plain') || html.classList.contains('still') || new URLSearchParams(location.search).has('still')
        || matchMedia('(prefers-reduced-motion: reduce)').matches;
      let timer, i = 0;
      root.querySelector('[data-kv-cell]').textContent = kv ? 'hit · prefill skipped' : 'cold';

      // Decode: one token at a time. Hits appear; misses show the model's guess inline first.
      const skipEvents = ['keydown', 'pointerdown', 'wheel', 'touchstart'];
      const finish = () => {
        clearTimeout(timer);
        skipEvents.forEach((e) => removeEventListener(e, finish, true));
        root.querySelectorAll('.ghost').forEach((g) => g.remove());
        toks.forEach((t) => { t.classList.add('on'); t.classList.remove('contested'); });
        root.classList.remove('decoding');
        root.classList.add('done');
        state.textContent = `DONE ${total} tok`;
        replay.hidden = still();
        try { sessionStorage.setItem('kv', '1'); } catch {}
        armIdle(); // defined below; finish only ever runs after the whole script has executed
      };
      const step = () => {
        if (i >= total) return finish();
        const t = toks[i];
        state.textContent = `DECODE ${i + 1}/${total}`;
        if (!t.dataset.guess) {
          t.classList.add('on');
          i++;
          timer = setTimeout(step, 30);
          return;
        }
        const ghost = document.createElement('span');
        ghost.className = 'ghost';
        ghost.setAttribute('aria-hidden', 'true');
        ghost.textContent = t.dataset.guess;
        t.before(ghost);
        t.classList.add('contested');
        timer = setTimeout(() => {
          ghost.remove();
          t.classList.remove('contested');
          t.classList.add('on', 'landed');
          i++;
          timer = setTimeout(step, 50);
        }, 120);
      };
      const start = () => {
        i = 0;
        hide();
        toks.forEach((t) => t.classList.remove('on', 'landed', 'contested'));
        root.classList.remove('done');
        root.classList.add('decoding');
        replay.hidden = true;
        skipEvents.forEach((e) => addEventListener(e, finish, true));
        timer = setTimeout(step, 450);
      };

      // Popover: the model's top-5 at the token under the pointer or keyboard focus.
      const active = { system: 0, reply: 0 };
      const label = (s) => `“${s.replace(/\n/g, '↵')}”`;
      const pct = (p) => (p < 0.001 ? '<0.001' : p.toFixed(3));
      const el = (tag, cls, text) => {
        const node = document.createElement(tag);
        if (cls) node.className = cls;
        if (text != null) node.textContent = text;
        return node;
      };
      const spansOf = (box) => [...box.querySelectorAll('[data-i]')];
      const show = (box, n) => {
        if (html.classList.contains('plain') || (box === reply && !root.classList.contains('done'))) return;
        const set = box.dataset.set, d = data[set][n], spans = spansOf(box), t = spans[n];
        active[set] = n;
        root.querySelectorAll('.active').forEach((x) => x.classList.remove('active'));
        t.classList.add('active');
        const verdict = d.h ? 'predicted' : 'missed';
        pop.replaceChildren(el('p', 'pop-head', `${label(t.textContent)}  p ${pct(d.p)} · ${d.b} bits · ${verdict}`));
        for (const [s, p] of d.k) {
          const bar = el('span', 'pop-bar');
          bar.style.setProperty('--w', `${Math.max(p * 100, 1)}%`);
          const row = el('p', 'pop-row');
          row.append(el('span', '', label(s)), bar, el('span', '', pct(p)));
          pop.append(row);
        }
        const phase = set === 'system' ? 'prefill · ' : '';
        pop.append(el('p', 'pop-foot', `${phase}teacher-forced · the text is mine, the probabilities are ${root.dataset.model}’s`));
        pop.hidden = false;
        const r = t.getBoundingClientRect(), box2 = root.getBoundingClientRect();
        pop.style.left = `${Math.max(0, Math.min(r.left - box2.left, box2.width - pop.offsetWidth))}px`;
        pop.style.top = `${r.bottom - box2.top + 8}px`;
      };
      function hide() {
        pop.hidden = true;
        root.querySelectorAll('.active').forEach((x) => x.classList.remove('active'));
      }
      for (const box of root.querySelectorAll('.scored')) {
        const pick = (e) => { const t = e.target.closest('[data-i]'); if (t && box.contains(t)) show(box, +t.dataset.i); };
        box.addEventListener('mouseover', pick);
        box.addEventListener('click', pick);
        box.addEventListener('mouseleave', () => { if (document.activeElement !== box) hide(); });
        box.addEventListener('focus', () => show(box, active[box.dataset.set]));
        box.addEventListener('blur', hide);
        box.addEventListener('keydown', (e) => {
          if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
            e.preventDefault();
            const last = spansOf(box).length - 1, cur = active[box.dataset.set];
            show(box, Math.min(last, Math.max(0, cur + (e.key === 'ArrowRight' ? 1 : -1))));
          } else if (e.key === 'Escape') {
            box.blur();
          }
        });
      }
      // Touch browsers may never focus a box, so also dismiss on any tap elsewhere.
      addEventListener('pointerdown', (e) => { if (!pop.hidden && !e.target.closest?.('.scored')) hide(); });

      replay.addEventListener('click', () => {
        reply.focus({ preventScroll: true });
        // Rerun the prefill too: drop the KV hit, restart the CSS animation, decode again.
        html.dataset.kv = 'hit';
        void root.offsetWidth;
        html.dataset.kv = 'cold';
        root.querySelector('[data-kv-cell]').textContent = 'cold';
        start();
      });

      // ARGMAX: the notes chip (click, or Enter when focused) anneals the temperature. Each token's opacity is
      // exp((log p - max) / T): as T falls, only the tokens the model was surest of survive,
      // then the chip morphs into the /notes heading (cross-document view transition).
      const chip = root.querySelector('[data-argmax]');
      let annealing = false;
      const argmax = (e) => {
        if (annealing || still() || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button > 0) return;
        e.preventDefault();
        annealing = true;
        stopSampling();
        finish();
        root.classList.add('annealing');
        // Fetch /notes while the anneal plays (prerender in Chromium, prefetch elsewhere).
        const rules = document.createElement('script');
        rules.type = 'speculationrules';
        rules.textContent = JSON.stringify({ prerender: [{ urls: [chip.href], eagerness: 'immediate' }] });
        document.head.append(rules, Object.assign(document.createElement('link'), { rel: 'prefetch', href: chip.href }));
        hide();
        const spans = [...root.querySelectorAll('.scored [data-i]')];
        const scores = spans.map((el) => Math.log(Math.max(data[el.closest('.scored').dataset.set][+el.dataset.i].p, 1e-9)));
        const max = Math.max(...scores), t0 = performance.now(), D = 650;
        // At T >= 1 the destination itself is sampled, not argmaxed.
        const T0 = readTemp();
        const dests = ['/notes', '/about', '/try'];
        const href = T0 >= 1 ? dests[Math.floor(Math.random() * dests.length)] : chip.href;
        particles(chip);
        let gone = false;
        const go = () => { if (!gone && annealing) { gone = true; location.href = href; } };
        setTimeout(go, D + 250); // hidden tabs pause animation frames; still navigate
        const frame = (now) => {
          if (!annealing) return; // restored from the back/forward cache meanwhile
          const k = Math.min((now - t0) / D, 1);
          const T = 8 * (1 - k) ** 2 + 0.01;
          spans.forEach((el, j) => { el.style.opacity = Math.exp((scores[j] - max) / T).toFixed(3); });
          state.textContent = T0 >= 1 ? `SAMPLED → ${href} · T ${T0}` : `ARGMAX · T ${T.toFixed(2)}`;
          if (k < 1) requestAnimationFrame(frame);
          else go();
        };
        requestAnimationFrame(frame);
      };
      chip.addEventListener('click', argmax);
      // Coming back via the back button restores the page as it was.
      addEventListener('pageshow', (e) => {
        if (!e.persisted) return;
        annealing = false;
        root.classList.remove('annealing');
        root.querySelectorAll('.scored [data-i]').forEach((el) => { el.style.opacity = ''; });
        state.textContent = `DONE ${total} tok`;
      });

      // ---------- Phase 3 ----------
      const readTemp = () => { try { const t = Number(localStorage.getItem('temp')); return t > 0 ? t : 0.7; } catch { return 0.7; } };
      const tempCell = root.querySelector('[data-temp]');
      const halluc = root.querySelector('[data-hallucination]');
      // Curated samples at high temperature: only my real words, scrambled.
      const HALLUCINATIONS = [
        'I build cricket that reads volleyball notes.',
        'Off the clock: predicting late-life badminton.',
        'I read models that build clinical games.',
        'Always up for a longitudinal game.',
        'I build notes that read clinical models.',
      ];
      const applyTemp = () => {
        const T = readTemp();
        tempCell.textContent = T >= 1.3 ? `${T} HALLUCINATING` : String(T);
        if (T >= 1.3 && !html.classList.contains('plain')) {
          halluc.textContent = `sampled at T ${T}: “${HALLUCINATIONS[Math.floor(Math.random() * HALLUCINATIONS.length)]}”`;
          halluc.hidden = false;
        } else {
          halluc.hidden = true;
        }
      };
      applyTemp();
      addEventListener('temperature', applyTemp);

      // Idle sampler: while the page sits still, the guess above a missed word is redrawn
      // from the model's real top-5 at that position, sampled at the current temperature.
      const misses = toks.filter((t) => t.dataset.guess);
      misses.forEach((t) => { t.dataset.guess0 = t.dataset.guess; });
      let idleTimer = 0, sampleTimer = 0, sampling = false;
      const stopSampling = () => {
        clearTimeout(idleTimer);
        clearTimeout(sampleTimer);
        if (sampling) {
          sampling = false;
          misses.forEach((t) => { t.dataset.guess = t.dataset.guess0; t.classList.remove('resampling'); });
          if (root.classList.contains('done')) state.textContent = `DONE ${total} tok`;
        }
      };
      const sampleOnce = () => {
        if (document.hidden || still() || annealing || !root.classList.contains('done') || !misses.length) return stopSampling();
        sampling = true;
        const T = readTemp();
        state.textContent = `SAMPLING top-5 · T ${T}`;
        const t = misses[Math.floor(Math.random() * misses.length)];
        const actual = t.textContent;
        const cands = data.reply[+t.dataset.i].k.filter(([s]) => s.replace(/\n/g, '') !== actual);
        const weights = cands.map(([, p]) => Math.pow(Math.max(p, 1e-9), 1 / T));
        let r = Math.random() * weights.reduce((a, w) => a + w, 0), pick = cands[0][0];
        for (let j = 0; j < cands.length; j++) { r -= weights[j]; if (r <= 0) { pick = cands[j][0]; break; } }
        t.classList.add('resampling');
        setTimeout(() => {
          t.dataset.guess = pick.replace(/\n/g, '↵').trim() || '·';
          t.classList.remove('resampling');
        }, 180);
        sampleTimer = window.setTimeout(sampleOnce, 1800);
      };
      const armIdle = () => {
        stopSampling();
        if (!still() && misses.length) idleTimer = window.setTimeout(sampleOnce, 5000);
      };
      ['pointerdown', 'keydown', 'wheel', 'touchstart', 'scroll'].forEach((e) => addEventListener(e, armIdle, { passive: true }));
      document.addEventListener('visibilitychange', () => (document.hidden ? stopSampling() : armIdle()));

      // ARGMAX particles: the faded tokens' characters stream into the chip. Canvas 2D,
      // capped (1,200 particles, 400 on touch), created on demand, removed afterwards.
      function particles(target) {
        const canvas = document.createElement('canvas');
        canvas.className = 'argmax-canvas';
        canvas.setAttribute('aria-hidden', 'true');
        const dpr = Math.min(devicePixelRatio || 1, 2);
        canvas.width = innerWidth * dpr;
        canvas.height = innerHeight * dpr;
        document.body.append(canvas);
        const ctx = canvas.getContext('2d');
        ctx.scale(dpr, dpr);
        ctx.font = '11px "Geist Mono", ui-monospace, monospace';
        const end = target.getBoundingClientRect();
        const tx = end.left + end.width / 2, ty = end.top + end.height / 2;
        const cap = matchMedia('(pointer: coarse)').matches ? 400 : 1200;
        const spans = [...root.querySelectorAll('.scored [data-i]')].filter((el) => el.textContent.trim());
        const per = Math.max(1, Math.floor(cap / Math.max(spans.length, 1)));
        const ps = [];
        for (const el of spans) {
          const r = el.getBoundingClientRect(), chars = el.textContent.trim();
          for (let k = 0; k < per && ps.length < cap; k++) {
            ps.push({ x: r.left + Math.random() * r.width, y: r.top + Math.random() * r.height, c: chars[k % chars.length], d: Math.random() * 180, blue: Math.random() < 0.3 });
          }
        }
        const t0 = performance.now(), D = 620;
        const draw = (now) => {
          if (!canvas.isConnected) return;
          ctx.clearRect(0, 0, innerWidth, innerHeight);
          let alive = false;
          for (const p of ps) {
            const k = Math.min(Math.max((now - t0 - p.d) / D, 0), 1);
            if (k < 1) alive = true;
            const e = k * k * (3 - 2 * k); // smoothstep
            ctx.globalAlpha = Math.round((1 - k) * 8) / 8; // 8 alpha buckets
            ctx.fillStyle = p.blue ? '#60a5fa' : '#ededed';
            ctx.fillText(p.c, p.x + (tx - p.x) * e, p.y + (ty - p.y) * e);
          }
          if (alive) requestAnimationFrame(draw);
          else canvas.remove();
        };
        requestAnimationFrame(draw);
      }
      addEventListener('pageshow', (e) => { if (e.persisted) document.querySelectorAll('.argmax-canvas').forEach((c) => c.remove()); });

      if (still() || kv) finish();
      else start();
    })();
  </script>
</div>
