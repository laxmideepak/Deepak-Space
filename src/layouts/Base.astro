---
import '../styles/global.css';
import { TAGS, getPosts, tokensIn } from '../lib';

const SITE_NAME = 'Deepak’s Tokenizer';
const EMAIL = 'nelapatladeepak@gmail.com';

interface Props { title?: string; description?: string; type?: 'website' | 'article' }
const { title, description = 'Deepak Nelapatla, ML engineer. Notes on what I learn at work, life, and the games I play.', type = 'website' } = Astro.props;
const fullTitle = title ? `${title} · ${SITE_NAME}` : SITE_NAME;
const path = Astro.url.pathname;
const canonical = new URL(path.replace(/(.)\/$/, '$1'), Astro.site);
const posts = await getPosts();
// For the : command line's `open` command.
const notes = posts.map((p) => ({ id: p.id, title: p.data.title }));
// The boot sequence: the site "trains" on first visit or reload, using my real history.
const corpus = posts.reduce((n, p) => n + tokensIn(p.body), 0);
const BOOT: [string, string][] = [
  ['data', `${posts.length} notes · ${corpus.toLocaleString('en-US')} tokens`],
  ['pretrain', 'B.Tech ECE · JNTU Hyderabad'],
  ['finetune', 'M.S. CS (AI/ML) · UT Arlington'],
  ['deploy', 'ML4H · Broad Institute'],
  ['live', 'deepaktokenizer.vercel.app'],
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#161616" />
    <script is:inline>
      // Before first paint: boot sequence, plain reading mode, and whether this session already watched the decode ("KV hit").
      try {
        const html = document.documentElement;
        const reload = performance.getEntriesByType('navigation')[0]?.type === 'reload';
        if (reload) sessionStorage.removeItem('kv'); // a reload replays everything
        const internal = document.referrer && new URL(document.referrer).origin === location.origin;
        const quiet = localStorage.getItem('plain') || localStorage.getItem('still') || document.prerendering
          || matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (!quiet && (reload || (!internal && !sessionStorage.getItem('booted')))) {
          html.classList.add('booting');
          sessionStorage.setItem('booted', '1');
        }
      } catch {}
      try { if (localStorage.getItem('plain')) document.documentElement.classList.add('plain'); } catch {}
      try { document.documentElement.dataset.kv = sessionStorage.getItem('kv') === '1' ? 'hit' : 'cold'; } catch {}
      try { if (localStorage.getItem('still')) document.documentElement.classList.add('still'); } catch {} // :temperature 0
    </script>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title ?? SITE_NAME} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/og.png', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Deepak Nelapatla: “I build models that read clinical notes.” shown as 8 tinted tokens" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="alternate" type="application/rss+xml" title={SITE_NAME} href="/rss.xml" />
    <!-- Self-hosted fonts (latin): no third-party round trips; the two above-the-fold faces preload. -->
    <link rel="preload" href="/fonts/geist.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/funnel-display-600.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/geist-mono.woff2" as="font" type="font/woff2" crossorigin />
    <!-- Prerender a page after a short hover (Chromium). Rules only, no script runs. -->
    <script type="speculationrules" is:inline>
      {"prerender":[{"where":{"and":[{"href_matches":"/*"},{"not":{"href_matches":"/rss.xml"}},{"not":{"href_matches":"/try"}}]},"eagerness":"moderate"}]}
    </script>
  </head>
  <body>
    <div class="boot" aria-hidden="true">
      <div class="boot-inner">
        <p class="boot-title">deepak-24 <span>one token at a time</span></p>
        <ol class="boot-steps">
          {BOOT.map(([k, v], i) => (
            <li style={`--i: ${i}`}>
              <span class="boot-k">{k}</span><span class="boot-v">{v}</span>
              <span class="boot-s"><span class="boot-run">···</span><span class="boot-ok">{k === 'live' ? '●' : '✓'}</span></span>
            </li>
          ))}
        </ol>
        <svg class="boot-loss" viewBox="0 0 200 36" preserveAspectRatio="none"><path pathLength="1" d="M0 3 C 30 6, 48 20, 72 24 S 130 31, 200 33" /></svg>
        <p class="boot-foot"><span>loss</span><span>converged</span></p>
      </div>
    </div>
    <script is:inline>
      // Fade the boot overlay after ~1.5 s, or at once on any key, tap or scroll.
      (() => {
        const html = document.documentElement;
        if (!html.classList.contains('booting')) return;
        const events = ['keydown', 'pointerdown', 'wheel', 'touchstart'];
        const done = () => {
          if (!html.classList.contains('booting')) return;
          html.classList.remove('booting', 'boot-skip');
          events.forEach((e) => removeEventListener(e, skip, true));
          dispatchEvent(new Event('booted'));
        };
        const skip = () => { html.classList.add('boot-skip'); setTimeout(done, 150); };
        events.forEach((e) => addEventListener(e, skip, true));
        setTimeout(done, 1750);
      })();
    </script>
    <a class="skip" href="#content">skip to content</a>
    <header class="site-header">
      <a href="/" class="site-name">{SITE_NAME}</a>
      <nav>
        <a href="/notes" aria-current={path.startsWith('/notes') ? 'page' : undefined}>notes</a>
        {TAGS.map((t) => <a href={`/tags/${t}`} aria-current={path.startsWith(`/tags/${t}`) ? 'page' : undefined}>{t}</a>)}
        <a href="/try" aria-current={path.startsWith('/try') ? 'page' : undefined}>try</a>
        <a href="/about" aria-current={path.startsWith('/about') ? 'page' : undefined}>about</a>
      </nav>
    </header>
    <main id="content" tabindex="-1">
      <slot />
    </main>
    <footer>
      <span>Deepak Nelapatla</span>
      <a href={`mailto:${EMAIL}`}>{EMAIL}</a>
      <a href="/rss.xml">rss</a>
      <span class="footer-tools">
        <button type="button" class="plain-toggle" data-cmd-open hidden>: cmd</button>
        <button type="button" class="plain-toggle" data-plain aria-pressed="false" aria-description="plain reading; also turns off the : keyboard shortcut" hidden>no tokens, please</button>
      </span>
    </footer>
    <form class="cmdline" data-cmdline hidden>
      <div class="cmdline-inner">
        <label for="cmd-input" aria-hidden="true">:</label>
        <input id="cmd-input" aria-label="command (type help)" autocomplete="off" autocapitalize="off" spellcheck="false" enterkeyhint="go" />
        <output class="cmdline-out" role="status" aria-live="polite" data-cmd-out></output>
      </div>
    </form>
    <script is:inline type="application/json" id="cmd-notes" set:html={JSON.stringify(notes).replace(/</g, '\\u003c')} />
    <script>
      // "No tokens, please": plain reading mode, remembered per browser. Hidden without JS.
      const plain = document.querySelector<HTMLButtonElement>('[data-plain]');
      const syncPlain = () => {
        if (!plain) return;
        const on = document.documentElement.classList.contains('plain');
        plain.setAttribute('aria-pressed', String(on));
        plain.textContent = on ? 'tokens, please' : 'no tokens, please';
      };
      if (plain) {
        plain.hidden = false;
        syncPlain();
        plain.addEventListener('click', () => {
          const on = document.documentElement.classList.toggle('plain');
          try { on ? localStorage.setItem('plain', '1') : localStorage.removeItem('plain'); } catch {}
          syncPlain();
        });
      }
      // Pages restored from the back/forward cache, or prerendered earlier, may hold stale
      // preferences from before a toggle on another page: re-read them.
      const syncPrefs = () => {
        try {
          document.documentElement.classList.toggle('plain', !!localStorage.getItem('plain'));
          document.documentElement.classList.toggle('still', !!localStorage.getItem('still'));
        } catch {}
        syncPlain();
      };
      addEventListener('pageshow', (e) => { if (e.persisted) syncPrefs(); });
      document.addEventListener('prerenderingchange', syncPrefs);

      // The : command line. Press ":" (or the footer button); errors come back as Python exceptions.
      const html = document.documentElement;
      const cmd = document.querySelector<HTMLFormElement>('[data-cmdline]')!;
      const cmdInput = cmd.querySelector<HTMLInputElement>('input')!;
      const cmdOut = cmd.querySelector<HTMLOutputElement>('[data-cmd-out]')!;
      const cmdButton = document.querySelector<HTMLButtonElement>('[data-cmd-open]')!;
      const cmdNotes: { id: string; title: string }[] = JSON.parse(document.getElementById('cmd-notes')!.textContent!);
      let returnFocus: HTMLElement | null = null;
      const openCmd = () => {
        returnFocus = document.activeElement as HTMLElement | null;
        cmd.hidden = false;
        cmdOut.textContent = '';
        cmdInput.value = '';
        cmdInput.focus();
      };
      const closeCmd = () => {
        cmd.hidden = true;
        const back = returnFocus && returnFocus !== document.body && returnFocus.isConnected ? returnFocus : document.getElementById('content');
        back?.focus({ preventScroll: true });
      };
      const say = (text: string) => { cmdOut.textContent = text; };
      const go = (href: string) => { closeCmd(); location.href = href; };
      const setStill = (on: boolean) => {
        html.classList.toggle('still', on);
        try { on ? localStorage.setItem('still', '1') : localStorage.removeItem('still'); } catch {}
      };
      const run = (raw: string) => {
        const [name = '', ...rest] = raw.trim().replace(/^:/, '').split(/\s+/);
        const arg = rest.join(' ');
        switch (name) {
          case '': return closeCmd();
          case 'help': case 'h':
            return say('open <words> · grep <regex> · temperature <t> · plain (also turns off the ":" key) · q');
          case 'open': case 'o': {
            if (!arg) return say("TypeError: open() missing 1 required positional argument: 'file'");
            const norm = (t: string) => t.toLowerCase().replace(/['’‘]/g, '').replace(/[-\s]+/g, ' ');
            const q = norm(arg);
            const hit = cmdNotes.find((n) => norm(n.title).includes(q) || norm(n.id).includes(q));
            return hit ? go(`/posts/${hit.id}`) : say(`FileNotFoundError: [Errno 2] No such note: '${arg}'`);
          }
          case 'grep': case 'g': return go(`/notes${arg ? `?q=${encodeURIComponent(arg)}` : ''}`);
          case 'temperature': case 't': {
            const t = Number(arg);
            if (!arg || Number.isNaN(t)) return say(`ValueError: could not convert string to float: '${arg}'`);
            if (t <= 0) {
              setStill(true);
              return say(`UserWarning: \`temperature\` (=${t}) has to be a strictly positive float, otherwise your next token scores will be invalid. Motion off.`);
            }
            setStill(false);
            try { localStorage.setItem('temp', String(t)); } catch {}
            dispatchEvent(new CustomEvent('temperature', { detail: t }));
            return say(`temperature=${t} · motion on`);
          }
          case 'plain': plain?.click(); return say(html.classList.contains('plain') ? 'plain reading on' : 'plain reading off');
          case 'q': case 'quit': case 'exit': say('<|endoftext|>'); setTimeout(closeCmd, 700); return;
          default: return say(`NameError: name '${name}' is not defined`);
        }
      };
      cmd.addEventListener('submit', (e) => { e.preventDefault(); run(cmdInput.value); cmdInput.select(); });
      cmd.addEventListener('keydown', (e) => { if (e.key === 'Escape') { e.preventDefault(); closeCmd(); } });
      // Tabbing or clicking away closes the bar without yanking focus back.
      cmd.addEventListener('focusout', (e) => {
        if (!cmd.contains(e.relatedTarget as Node | null) && document.hasFocus()) cmd.hidden = true;
      });
      cmdButton.hidden = false;
      cmdButton.addEventListener('click', openCmd);
      addEventListener('keydown', (e) => {
        const t = e.target as HTMLElement;
        const typing = t.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(t.tagName);
        // Single-key shortcut: off in plain mode (WCAG 2.1.4); the footer button always works.
        if (e.key === ':' && !typing && !e.ctrlKey && !e.metaKey && !e.altKey && !html.classList.contains('plain')) {
          e.preventDefault();
          openCmd();
        }
      });
    </script>
  </body>
</html>
